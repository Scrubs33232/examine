# ==============================================================================
# FOMO Engine - Environment Configuration
# Copy this file to `.env` and fill in your real values.
# NEVER commit the actual `.env` file to version control.
# ==============================================================================

# --- Exchange credentials -----------------------------------------------------
# Any exchange supported by CCXT (e.g. binance, coinbase, kraken, kucoin).
EXCHANGE_ID=binance
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here
# Some exchanges (e.g. KuCoin, OKX) require an additional passphrase. Leave blank otherwise.
EXCHANGE_API_PASSWORD=

# Use the exchange's sandbox/testnet endpoints when available.
USE_EXCHANGE_SANDBOX=true

# --- Safety switch -------------------------------------------------------------
# When true, NO real orders are ever sent. All fills are simulated locally.
# You must deliberately set this to "false" to place live orders.
DRY_RUN=true

# Starting balance used to seed the paper-trading wallet when DRY_RUN=true.
PAPER_WALLET_QUOTE_BALANCE=10000
PAPER_WALLET_QUOTE_CURRENCY=USDT

# --- Trading universe -----------------------------------------------------------
# Comma-separated list of CCXT unified symbols.
TRADING_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT

# Candle timeframe used for signal detection (CCXT timeframe string).
TIMEFRAME=1m

# How often (seconds) the main loop polls for new market data.
POLL_INTERVAL_SECONDS=15

# --- Strategy thresholds ("FOMO" triggers) --------------------------------------
VOLUME_MA_PERIOD=20
VOLUME_SPIKE_MULTIPLIER=3.0

RSI_PERIOD=14
RSI_BREAKOUT_THRESHOLD=65

PRICE_VELOCITY_LOOKBACK_CANDLES=5
PRICE_VELOCITY_THRESHOLD_PCT=2.0

# --- Risk management -------------------------------------------------------------
# Max % of total wallet balance allocated to a single new position.
MAX_POSITION_PCT=3.0

# Max number of concurrent open positions.
MAX_OPEN_POSITIONS=3

# Circuit breaker: halt all trading once daily realized+unrealized loss exceeds this % of
# the balance recorded at the start of the trading day (UTC).
MAX_DAILY_DRAWDOWN_PCT=5.0

# Exit rules.
TRAILING_STOP_PCT=1.5
TAKE_PROFIT_PCT=3.0

# Reject an order if the fetched quote price has moved more than this % since the
# signal was generated (protects against slippage on fast-moving markets).
MAX_SLIPPAGE_PCT=0.5

# Minimum quote-currency balance to keep in reserve, never fully deployed.
MIN_RESERVE_QUOTE_BALANCE=100

# --- Logging ---------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FILE=logs/fomo_engine.log
