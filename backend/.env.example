# Copy this file to .env and fill in real values.

# --- AI provider (at least one required) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+asyncpg://examine:examine@localhost:5432/examine

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- OCR ---
# Path to the tesseract binary if not on PATH (e.g. C:\Program Files\Tesseract-OCR\tesseract.exe)
TESSERACT_CMD=
# Optional: use Google Vision instead of local Tesseract
GOOGLE_VISION_API_KEY=

# --- News / sentiment (optional, used to enrich analysis) ---
NEWS_API_KEY=

# --- Object storage for uploaded screenshots (optional, used in production) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
