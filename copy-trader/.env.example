# --- RPC (premium provider required — public RPC will drop subscriptions under load) ---
RPC_HTTPS_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
RPC_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY

# --- Target wallet(s) to mirror, comma-separated ---
# Only used once, to seed target-wallets.json on first boot. After that, add
# or remove wallets from the website's Copy Trader page instead — they're
# public addresses, so that's managed via the control API, not .env.
TARGET_WALLETS=
TARGET_WALLETS_PATH=./target-wallets.json

# --- Key management ---
# Generate with: npm run generate-encryption-key
WALLET_ENCRYPTION_KEY=
ENCRYPTED_KEY_PATH=./bot-wallet.enc.json
# Optional but recommended: paste the bot wallet's own pubkey here as a sanity
# check — startup refuses to run if the decrypted key doesn't match this.
BOT_WALLET_PUBKEY=

# --- Execution mode ---
# true = size and log trades without ever sending them on-chain.
DRY_RUN=false

# --- Position sizing ---
BUY_SOL_CAP=0.5
BUY_PORTFOLIO_PERCENT=10
FEE_BUFFER_SOL=0.03

# --- Risk bounds ---
SLIPPAGE_BPS=200
MIN_LIQUIDITY_SOL=5
MAX_PRICE_IMPACT_PCT=15
MAX_SAFE_WALLET_SOL=2

# --- Execution relay ---
# Leave blank to submit via your RPC directly. Set to use Jito bundles
# instead (e.g. https://mainnet.block-engine.jito.wtf).
JITO_BLOCK_ENGINE_URL=
JITO_TIP_SOL=0.0002

# --- Fees ---
PRIORITY_FEE_PERCENTILE=75

# --- Control API (backs the website's Copy Trader page) ---
API_PORT=8787
CORS_ORIGIN=http://localhost:3000
# false = boot idle, wait for the website's Start button / POST /api/start
AUTO_START=true

# --- Trade alert webhooks (optional, both independent) ---
# Telegram: message @BotFather to create a bot and get a token; get your
# chat_id by messaging the bot once and hitting
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: server settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=

# --- FOMO/momentum validation, take-profit laddering, trailing stop, time
# limit, and position-sizing mode are all UI-managed via the website's Copy
# Trader settings panel (same reasoning as stop-loss/take-profit above) —
# no .env vars for them. See settingsStore.ts for the full field list and
# defaults, and README.md's "FOMO validation engine" section.
POSITION_STATE_PATH=./position-state.json
